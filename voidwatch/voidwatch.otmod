Module
  name: voidwatch
  description: Writes the character state for the Voidwatch upload script and runs the commands it brings back
  author: Voidwatch
  website: https://voidwatch.xyz/developers
  version: 0.6.0
  sandboxed: true
  autoload: true
  autoload-priority: 1000
  scripts: [ voidwatch, orion, orion_autoloot, orion_tasks, voidwatch_ui ]
  @onLoad: Voidwatch.init()
  @onUnload: Voidwatch.terminate()
